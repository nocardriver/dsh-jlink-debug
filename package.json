{
  "name": "@nocardriver/dsh-jlink-debug",
  "version": "0.1.0",
  "private": true,
  "description": "SEGGER J-Link debugging, symbol-aware memory access and firmware flashing for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "jlink.js",
    "session.js",
    "rsp.js",
    "elf.js",
    "devices.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/cosmokit": "^1.8.3",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
